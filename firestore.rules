rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isSuperAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }

    function isAdminOrSuper() {
      return isAdmin() || isSuperAdmin() || (isAuthenticated() && request.auth.token.email == 'isak@gmail.com');
    }

    // --- System Settings Collection ---
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdminOrSuper() || isAdmin();
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if isUser(userId) || isAdmin();
      allow create: if isAdmin() || (
        isUser(userId) &&
        request.resource.data.role == 'student' &&
        !request.resource.data.keys().hasAny(['permissions', 'sectionPermissions', 'disabled'])
      );
      allow update: if isAdmin() || (
        isUser(userId) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.get('permissions', null) == resource.data.get('permissions', null) &&
        request.resource.data.get('sectionPermissions', null) == resource.data.get('sectionPermissions', null) &&
        request.resource.data.get('disabled', null) == resource.data.get('disabled', null)
      );
      allow delete: if isAdmin();
    }

    // --- Exams Collection ---
    match /exams/{examId} {
      function isExamCreator() {
        return isAuthenticated() && resource.data.createdBy == request.auth.uid;
      }

      allow read: if isAuthenticated() || resource.data.isPublished == true;
      allow create: if isAdmin() || (isAuthenticated() && request.resource.data.createdBy == request.auth.uid);
      allow update: if isAdmin() || isExamCreator();
      allow delete: if isAdmin() || isExamCreator();

      match /questions/{questionId} {
        function isParentExamCreator() {
          return isAuthenticated() && get(/databases/$(database)/documents/exams/$(examId)).data.createdBy == request.auth.uid;
        }
        function canSaveQuestionData() {
          return request.resource.data.get('generatedByAI', false) != true ||
            (
              isAdmin() &&
              get(/databases/$(database)/documents/exams/$(examId)).data.get('isPublished', false) != true
            );
        }
        allow read: if isAuthenticated() || 
          get(/databases/$(database)/documents/exams/$(examId)).data.get('isPublished', false) == true ||
          get(/databases/$(database)/documents/exams/$(examId)).data.get('published', false) == true;
        allow create, update: if (isAdmin() || isParentExamCreator()) && canSaveQuestionData();
        allow delete: if isAdmin() || isParentExamCreator();
      }

      match /blockedStudents/{studentId} {
        function isParentExamCreator() {
          return isAuthenticated() && get(/databases/$(database)/documents/exams/$(examId)).data.createdBy == request.auth.uid;
        }
        allow read: if isAuthenticated();
        allow write: if isAdmin() || isParentExamCreator();
      }
    }

    // --- Exam Attempts Collection ---
    match /examAttempts/{attemptId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isAdminOrSuper();

      match /answers/{answerId} {
        allow read, create, update: if true;
        allow delete: if isAdminOrSuper();
      }
    }

    // --- Departments Collection ---
    match /departments/{departmentId} {
      allow read: if true;
      allow write: if isAdminOrSuper() || isAdmin();
    }

    // --- Subjects Collection ---
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isAuthenticated() || isAdminOrSuper();

      match /chapters/{chapterId} {
        allow read: if true;
        allow write: if isAuthenticated() || isAdminOrSuper();
      }
    }

    // --- Leaderboard Collections ---
    match /leaderboardCache/{departmentId} {
      allow read: if isAuthenticated() || resource.data.isPublished == true;
      allow write: if isAdmin();
    }

    match /leaderboardRankings/{rankingId} {
      allow read: if isAuthenticated() || resource.data.isPublished == true;
      allow write: if isAdmin();
    }

    // --- Archived Results Collection ---
    match /archivedResults/{resultId} {
      // Students can read their own archived results, admins can read all
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.studentId == request.auth.uid
      );
      allow write: if isAdmin();
    }

    // --- Student Feedback/Messages Collection ---
    match /studentFeedback/{feedbackId} {
      // Students can create their own messages
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Students can read their own messages, admins can read all
      allow read: if isAuthenticated() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid
      );
      
      // Students can delete their own messages, admins can delete any
      allow delete: if isAuthenticated() && (
        isAdmin() || 
        resource.data.userId == request.auth.uid
      );
      
      // Only admins can update messages
      allow update: if isAdmin();

      match /replies/{replyId} {
        // Both students and admins can create replies
        allow create: if isAuthenticated();
        
        // Students can read replies to their own messages, admins can read all
        allow read: if isAuthenticated() && (
          isAdmin() || 
          get(/databases/$(database)/documents/studentFeedback/$(feedbackId)).data.userId == request.auth.uid
        );
        
        // Only admins can update/delete replies
        allow update, delete: if isAdmin();
      }
    }

    // --- Digital Book Library Collection ---
    match /books/{bookId} {
      // Authenticated users or public published reading
      allow read: if isAuthenticated() || resource.data.status == 'published';
      // Allow admins, superadmins, or authenticated creators to create books
      allow create: if isAuthenticated() && (
        isAdminOrSuper() ||
        request.resource.data.createdBy == request.auth.uid
      );
      // Allow admins, the creator, or counters update (views/downloads)
      allow update: if isAuthenticated() && (
        isAdminOrSuper() ||
        resource.data.createdBy == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount', 'downloadCount'])
      );
      // Allow admins or the creator to delete
      allow delete: if isAuthenticated() && (
        isAdminOrSuper() ||
        resource.data.createdBy == request.auth.uid
      );
    }

    // --- Book Bookmarks Collection ---
    match /bookBookmarks/{bookmarkId} {
      // Authenticated users can read and write their own bookmarks
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdminOrSuper()
      );
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdminOrSuper()
      );
    }

    // --- Community Channels & Messages Collection ---
    match /communityChannels/{channelId} {
      allow read: if true;
      allow write: if isAuthenticated() || isAdminOrSuper();

      match /{allChildren=**} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
    }

    match /communityMessages/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
