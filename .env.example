# ==========================================
# ExamPro Environment Configuration Template
# ==========================================
# Copy to .env.local for local development (it is gitignored). Never commit secrets.
# Server-side AI provider keys (GEMINI_API_KEY etc.) are read by src/server/env.ts
# into the dev server's process.env — never with a VITE_ prefix.

# ------------------------------------------
# 1. Cloudinary Image Storage (Recommended)
# ------------------------------------------
# Used for subject cover images with automatic 4:3 crop, WebP/AVIF formatting,
# responsive CDN caching, and high performance.
#
# Setup Steps:
# 1. Sign up for a free account at https://cloudinary.com
# 2. Go to Settings (gear icon) -> Upload -> "Upload presets"
# 3. Click "Add upload preset":
#    - Preset name: exampro_unsigned (or your custom name)
#    - Signing Mode: Unsigned (Required for direct client-side upload)
#    - Folder: exampro/subjects (Optional - ExamPro automatically organizes assets)
# 4. Copy your Cloud Name and Upload Preset name below:

VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# ------------------------------------------
# 2. Firebase Configuration
# ------------------------------------------
# (If Cloudinary is not configured or fails, ExamPro automatically
# falls back to Firebase Storage under `subject-covers/`)

VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ------------------------------------------
# 3. AI Providers (Gemini, Groq, OpenRouter, Hugging Face)
# ------------------------------------------
# Used server-side by the API functions (e.g. /api/ai/*, /api/chatbot/ask).
# IMPORTANT: do NOT prefix PRIVATE provider keys with VITE_ — Vite embeds
# VITE_* variables into the public client bundle. Keep them server-only:
#   GEMINI_API_KEY / GROQ_API_KEY / OPENROUTER_API_KEY / HUGGINGFACE_API_KEY
# Set them in your server environment (Vercel project env vars), not here.
#
# The VITE_ names below are kept ONLY for optional client-side features and
# any keys placed here become PUBLIC (anyone can read the built bundle).
# Prefer the AI Provider Settings in the Admin UI (stored in Firestore).

# VITE_GEMINI_API_KEY=
# VITE_GROQ_API_KEY=
# VITE_OPENROUTER_API_KEY=
# VITE_HUGGINGFACE_API_KEY=
# Server-side equivalents (recommended; set on the host, never commit):
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# HUGGINGFACE_API_KEY=

